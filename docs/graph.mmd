---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	guard(guard)
	router(router)
	extractor(extractor)
	resolver(resolver)
	clarify(clarify)
	specialist(specialist)
	synthesizer(synthesizer)
	verifier(verifier)
	__end__([<p>__end__</p>]):::last
	__start__ --> guard;
	clarify --> router;
	extractor --> resolver;
	guard -.-> __end__;
	guard -.-> router;
	resolver -.-> clarify;
	resolver -.-> specialist;
	router --> extractor;
	specialist --> synthesizer;
	synthesizer --> verifier;
	verifier -.-> __end__;
	verifier -.-> synthesizer;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

